NEXT_PUBLIC_GTNH_DATASET_MANIFEST_URL=/datasets/gtnh/datasets.manifest.json
# Optional: proxy dataset files and /api/datasets to another deployment instead of
# serving public/datasets/gtnh. Leave unset to run standalone on your own dataset.
# GTNH_DATASET_BACKEND_URL=

# This deployment's address and links (src/lib/site.ts). Unset links are hidden.
NEXT_PUBLIC_SITE_URL=https://gtnhplanretro.tfaluc.com
NEXT_PUBLIC_SOURCE_URL=
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_SUPPORT_URL=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_HOST_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Community hub (see docs/COMMUNITY.md). Server-side only — never expose the
# service role key to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
COMMUNITY_HASH_SALT=
# Optional: lets the site admin delete any community post via
# DELETE /api/community/plans/<id> with header "x-admin-token: <value>".
COMMUNITY_ADMIN_TOKEN=
